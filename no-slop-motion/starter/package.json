{
	"name": "acme-launch-film",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1 npx --yes hyperframes@0.8.78 preview",
